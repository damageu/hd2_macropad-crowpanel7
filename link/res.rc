1 ICON "app.ico"
1 VERSIONINFO
FILEVERSION 1,2,7,0
PRODUCTVERSION 1,2,7,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "HD2 Macropad Link"
      VALUE "ProductName", "HD2 Macropad Link"
      VALUE "FileVersion", "1.2.7"
      VALUE "ProductVersion", "1.2.7"
      VALUE "Comments", "First-install and app update for CrowPanel Advance 7.0. Updater core 1.2.3. Flash baud at most 460800."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

/* Bundled CrowPanel Advance 7.0 firmware for the one-file first install.
 * 101 bootloader, 102 cp7 partition table, 103 v1.9.2-cp7.2 app,
 * 104 the 4 MiB assets FAT (sounds) at 0xA10000.
 * The app is this tree's port of upstream v1.9.2 and is not hardware-tested.
 * The assets file is the unchanged cp7/cp7.1/cp7.2 sound image. */
101 RCDATA "firmware/bootloader.bin"
102 RCDATA "firmware/partitions.bin"
103 RCDATA "../tools/crowpanel/test-package/hd2_macropad_v1.9.2-cp7.2_app_0x10000.bin"
104 RCDATA "firmware/assets_fat_0xa10000.img"
