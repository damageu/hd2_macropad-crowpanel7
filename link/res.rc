PRODUCTVERSION 1,2,4,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "HD2 Macropad Link"
      VALUE "ProductName", "HD2 Macropad Link"
      VALUE "FileVersion", "1.2.4"
      VALUE "ProductVersion", "1.2.4"
      VALUE "Comments", "First-install and app update for CrowPanel Advance 7.0. Updater core 1.2.3. Flash baud at most 460800."
