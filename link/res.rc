/* Bundled CrowPanel Advance 7.0 firmware for the one-file first install.
 * 101 bootloader, 102 cp7 partition table, 103 tested v1.9.1-cp7.2 app.
 * The app file is the hardware-tested image. Do not substitute a rebuild. */
101 RCDATA "firmware/bootloader.bin"
102 RCDATA "firmware/partitions.bin"
103 RCDATA "../tools/crowpanel/test-package/hd2_macropad_v1.9.1-cp7.2_app_0x10000.bin"
